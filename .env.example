# Create a bot with Telegram's @BotFather.
TELEGRAM_BOT_TOKEN=replace-me

# Comma-separated numeric Telegram user/chat IDs allowed to operate the bot.
ALLOWED_CHAT_IDS=123456789

# Optional static targets. Verified targets can be added from Telegram.
TARGET_ALLOWLIST=

# Use the same long random secret on the bot and each verifier agent.
VERIFICATION_SECRET=replace-with-a-long-random-secret
VERIFIER_PORT=39001
